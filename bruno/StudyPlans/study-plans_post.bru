meta {
  name: /study-plans (POST)
  type: http
  seq: 72
}

post {
  url: {{baseUrl}}/study-plans
  body: json
  auth: inherit
}

body:json {
  {
    "code": "{{studyPlanCode}}",
    "name": "{{studyPlanName}}"
  }
}

docs {
  POST `/study-plans` Roles: Admin. JSON body: code, name. Response: 201 bare plan object. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {
  res.status: eq 201
  res.body: isJson
}
