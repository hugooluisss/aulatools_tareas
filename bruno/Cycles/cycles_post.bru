meta {
  name: /cycles (POST)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/cycles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{cycleName}}",
    "starts_on": "{{cycleStartsOn}}",
    "ends_on": "{{cycleEndsOn}}"
  }
}

docs {
  POST `/cycles` Roles: Admin. JSON body: name, starts_on, ends_on; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
