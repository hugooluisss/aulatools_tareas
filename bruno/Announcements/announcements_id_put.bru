meta {
  name: /announcements/{id} (PUT)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/announcements/{{announcementId}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Parent meeting",
    "body": "The school meeting is scheduled for October 20.",
    "starts_on": "2026-10-02",
    "ends_on": "2026-10-20"
  }
}

docs {
  PUT `/announcements/id` Roles: Admin. Path ids: id. JSON body: title, body, starts_on, ends_on; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
