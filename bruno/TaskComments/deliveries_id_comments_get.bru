get {
  url: {{baseUrl}}/deliveries/{{deliveryId}}/comments
  auth: inherit
}

docs {
  GET `/deliveries/id/comments` Roles: Admin, delivery's teacher, owning student. Path ids: id. Response: 200 {items:[...],page,per_page,total,total_pages}. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body.items: isArray
  res.body.page: isDefined
