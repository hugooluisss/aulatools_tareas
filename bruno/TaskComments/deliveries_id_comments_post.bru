meta {
  name: /deliveries/{id}/comments (POST)
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/deliveries/{{deliveryId}}/comments
  body: json
  auth: inherit
}

body:json {
  {
    "body": "Please review question 3; I attached my working."
  }
}

docs {
  POST `/deliveries/id/comments` Roles: Admin, delivery's teacher, owning student. Path ids: id. JSON body: body; use valid IDs and dates accepted by the API. Response: 201 bare comment object with id, delivery_id, author, body, created_at. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
