meta {
  name: /auth/reset-password (POST)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
}

body:json {
  {
    "token": "{{resetToken}}",
    "password": "{{newPassword}}"
  }
}

docs {
  POST `/auth/reset-password` Roles: Public. JSON body: token, password (minimum 8 characters). Returns 200 `{message}` on success or 400 `{error:{code,message}}` for invalid or expired tokens and weak passwords.
}

assert {
  res.status: eq 200
}
