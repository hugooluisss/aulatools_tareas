meta {
  name: /auth/register-school (POST)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/register-school
}


body:json {
  {
    "school_name": "Northstar Academy",
    "first_name": "Avery",
    "last_name": "Morgan",
    "email": "avery.admin@example.test",
    "password": "ChangeMe123!"
  }
}

docs {
  POST `/auth/register-school` Roles: Public. JSON body: school_name, first_name, last_name, email, password; use valid IDs and dates accepted by the API. Response: 201 `{message}` on success. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isObject

}
