  }
}

docs {
  POST `/auth/register-school` Roles: Public. JSON body: school_name, first_name, last_name, email, password; use valid IDs and dates accepted by the API. Response: 201 `message` (controller response). Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 201

}
