meta {
  name: /auth/change-password (POST)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "{{adminPassword}}",
    "new_password": "NewPass123!"
  }
}

docs {
  POST `/auth/change-password` Roles: Any authenticated role. JSON body: current_password, new_password; use valid IDs and dates accepted by the API. Response: 200 `message: Password updated`. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
