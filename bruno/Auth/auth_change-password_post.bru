meta {
  name: /auth/change-password (POST)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/change-password
}

body:json {
  {
    "current_password": "{{adminPassword}}",
    "new_password": "NewPass123!"
  }
}

docs {
  POST `/auth/change-password` Roles: Any authenticated role. JSON body: current_password, new_password; use valid IDs and dates accepted by the API. Response: 200 `message: Password updated`. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 200

}
