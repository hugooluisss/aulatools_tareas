meta {
  name: /auth/login (POST)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}


script:post-response {

  bru.setEnvVar("token", res.body.token);

}

docs {
  POST `/auth/login` Roles: Public. JSON body: email, password; use valid IDs and dates accepted by the API. Response: 200 `token`; post-response saves token to `token` env var. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200

}
