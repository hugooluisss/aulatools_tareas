meta {
  name: /auth/forgot-password (POST)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}"
  }
}

docs {
  POST `/auth/forgot-password` Roles: Public. JSON body: email. Always returns 200 `{message}` with the same message whether the email is registered.
}

assert {
  res.status: eq 200
}
