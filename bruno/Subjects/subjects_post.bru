meta {
  name: /subjects (POST)
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/subjects
}

body:json {
  {
    "cycle_id": "{{cycleId}}",
    "teacher_id": "{{teacherId}}",
    "name": "Science"
  }
}

docs {
  POST `/subjects` Roles: Admin. JSON body: cycle_id, teacher_id, name; use valid IDs and dates accepted by the API. Response: 200/201 data with the resource; errors use documented error object. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 201

}
