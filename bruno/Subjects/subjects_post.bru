meta {
  name: /subjects (POST)
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/subjects
}

body:json {
  {
    "cycle_id": "{{cycleId}}",
    "teacher_id": "{{teacherId}}",
    "name": "Science"
  }
}

docs {
  POST `/subjects` Roles: Admin. JSON body: cycle_id, teacher_id, name; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isObject

}
