meta {
  name: /subjects (POST)
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/subjects
  body: json
  auth: inherit
}

body:json {
  {
    "code": "{{subjectCode}}",
    "teacher_id": "{{teacherId}}",
    "name": "{{subjectName}}",
    "plan_id": {{planId}}
  }
}

docs {
  POST `/subjects` Roles: Admin. JSON body: code, name, teacher_id, optional plan_id. Response: 201 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
