meta {
  name: /subjects/{id}/students (GET)
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/subjects/{{subjectId}}/students
  auth: inherit
}

docs {
  GET `/subjects/id/students` Roles: Admin, assigned teacher, enrolled student. Path ids: id. Response: 200 bare JSON array with teacher_id per row; pagination in X-Total-Count, X-Page, X-Per-Page headers. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isArray
  res.headers["X-Total-Count"][0]: isDefined
  res.headers["X-Page"][0]: isDefined
  res.headers["X-Per-Page"][0]: isDefined

}
