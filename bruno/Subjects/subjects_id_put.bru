meta {
  name: /subjects/{id} (PUT)
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/subjects/{{subjectId}}
  body: json
  auth: inherit
}

body:json {
  {
    "code": "{{subjectCode}}",
    "teacher_id": "{{teacherId}}",
    "name": "Science",
    "plan_id": {{planId}},
    "status": "active"
  }
}

docs {
  PUT `/subjects/id` Roles: Admin. Path ids: id. JSON body: code, name, teacher_id, optional plan_id, status (`active` or `inactive`). Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
