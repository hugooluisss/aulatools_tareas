meta {
  name: /subjects/{id} (PUT)
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/subjects/{{subjectId}}
}

body:json {
  {
    "cycle_id": "{{cycleId}}",
    "teacher_id": "{{teacherId}}",
    "name": "Science",
    "status": "in_progress"
  }
}

docs {
  PUT `/subjects/id` Roles: Admin. Path ids: id. JSON body: cycle_id, teacher_id, name, status; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isObject

}
