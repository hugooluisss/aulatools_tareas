meta {
  name: /enrollments/bulk (POST)
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/enrollments/bulk
  body: json
  auth: inherit
}

body:json {
  {
    "type": "{{bulkType}}",
    "student_ids": [{{bulkStudentIds}}],
    "cycle_id": {{cycleId}},
    "group_id": {{groupId}}
  }
}

docs {
  POST `/enrollments/bulk` Roles: Admin. JSON body: type, student_ids, cycle_id, group_id. Response: 201 bare JSON array of inscriptions; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {
  res.status: eq 201
  res.body: isJson
}
