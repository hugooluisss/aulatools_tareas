meta {
  name: /enrollments (POST)
  type: http
  seq: 64
}

post {
  url: {{baseUrl}}/enrollments
  body: json
  auth: inherit
}

body:json {
  {
    "student_id": {{studentId}},
    "cycle_id": {{cycleId}},
    "group_id": {{groupId}}
  }
}

docs {
  POST `/enrollments` Roles: Admin. JSON body: student_id, cycle_id, group_id. Response: 201 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {
  res.status: eq 201
  res.body: isJson
}
