meta {
  name: /users/students/{id} (PUT)
  type: http
  seq: 55
}

put {
  url: {{baseUrl}}/users/students/{{studentId}}
  body: json
  auth: inherit
}

body:json {
  {
    "first_name": "Riley",
    "last_name": "Student",
    "email": "riley.student@example.test",
    "birth_date": "2012-05-14",
    "status": "active",
    "address": "456 Oak Avenue",
    "contact_phone": "+52 55 1234 5678",
    "guardian_name": "Taylor Student",
    "guardian_phone": "+52 55 8765 4321"
  }
}

docs {
  PUT `/users/students/id` Roles: Admin. Path ids: id. JSON body: first_name, last_name, email, birth_date, status; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
