meta {
  name: /users/teachers (POST)
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/users/teachers
  auth: inherit
  body: json
}

body:json {
  {
    "first_name": "{{teacherFirstName}}",
    "last_name": "{{teacherLastName}}",
    "email": "{{teacherEmail}}",
    "password": "{{teacherPassword}}",
    "address": "123 Main Street",
    "phone": "+52 55 1234 5678"
  }
}

docs {
  POST `/users/teachers` Roles: Admin. JSON body: first_name, last_name, email, password; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
