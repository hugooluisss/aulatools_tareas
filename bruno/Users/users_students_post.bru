}

docs {
  POST `/users/students` Roles: Admin. JSON body: first_name, last_name, email, password, enrollment_number, birth_date, status; use valid IDs and dates accepted by the API. Response: 200/201 data with the resource; errors use documented error object. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 201

