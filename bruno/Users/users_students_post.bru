meta {
  name: /users/students (POST)
  type: http
  seq: 57
}

post {
  url: {{baseUrl}}/users/students
  body: json
  auth: inherit
}

body:json {
  {
    "first_name": "Riley",
    "last_name": "Student",
    "email": "riley.student@example.test",
    "password": "ChangeMe123!",
    "birth_date": "2012-05-14",
    "status": "active",
    "address": "456 Oak Avenue",
    "contact_phone": "+52 55 1234 5678",
    "guardian_name": "Taylor Student",
    "guardian_phone": "+52 55 8765 4321"
  }
}

docs {
  POST `/users/students` Roles: Admin. JSON body: first_name, last_name, email, password, birth_date, status; use valid IDs and dates accepted by the API. Response: 201 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
