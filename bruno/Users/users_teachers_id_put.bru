meta {
  name: /users/teachers/{id} (PUT)
  type: http
  seq: 61
}

put {
  url: {{baseUrl}}/users/teachers/{{teacherId}}
  body: json
  auth: inherit
}

body:json {
  {
    "first_name": "Jamie",
    "last_name": "Teacher",
    "email": "jamie.teacher@example.test"
  }
}

docs {
  PUT `/users/teachers/id` Roles: Admin. Path ids: id. JSON body: first_name, last_name, email; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
