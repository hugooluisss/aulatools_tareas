meta {
  name: /users/students/{id}/status (PATCH)
  type: http
  seq: 56
}

patch {
  url: {{baseUrl}}/users/students/{{studentId}}/status
}

body:json {
  {
    "status": "inactive"
  }
}

docs {
  PATCH `/users/students/id/status` Roles: Admin. Path ids: id. JSON body: status; use valid IDs and dates accepted by the API. Response: 200/201 data with the resource; errors use documented error object. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 200

}
