meta {
  name: /subjects/{subject_id}/tasks (POST)
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/subjects/{{subjectId}}/tasks
}

body:json {
  {
    "name": "Chapter 1",
    "description": "Read and answer questions 1–5.",
    "due_at": "2026-10-15T23:59:00-06:00"
  }
}

docs {
  POST `/subjects/subject_id/tasks` Roles: Admin, assigned teacher. Path ids: subject_id. JSON body: name, description, due_at; use valid IDs and dates accepted by the API. Response: 201 bare resource object. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isObject

}
