meta {
  name: /subjects/{subject_id}/tasks (POST)
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/subjects/{{subjectId}}/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "cycle_id": {{cycleId}},
    "name": "Chapter 1",
    "description": "Read and answer questions 1–5.",
    "due_at": "2026-10-15"
  }
}

docs {
  POST `/subjects/subject_id/tasks` Roles: Admin, assigned teacher. Path ids: subject_id. JSON body: cycle_id, name, description, due_at (`YYYY-MM-DD`). Response: 201 bare resource object. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
