meta {
  name: /tasks/{id} (GET)
  type: http
  seq: 49
}

get {
  url: {{baseUrl}}/tasks/{{taskId}}
  auth: inherit
}

docs {
  GET `/tasks/id` Roles: Admin, task's teacher, enrolled student. Path ids: id. Response: 200 bare task object with optional delivery and teacher. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
