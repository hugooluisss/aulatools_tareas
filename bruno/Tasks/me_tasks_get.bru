meta {
  name: /me/tasks (GET)
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/me/tasks
  auth: inherit
}

docs {
  GET `/me/tasks` Roles: Student. Query parameters: optional comma-separated `status` (`pending`,`delivered`,`graded`,`cancelled`), `search` (task or subject name), `cycle_id`, `page`, `per_page`. Absent or empty status and cycle return all statuses and cycles. Response: 200 `{items:[...],page,per_page,total,total_pages}`. Errors: invalid status/cycle or pagination returns HTTP 400.
}

assert {

  res.status: eq 200
  res.body.items: isArray
  res.body.page: isDefined
  res.body.per_page: isDefined
  res.body.total: isDefined
  res.body.total_pages: isDefined

}
