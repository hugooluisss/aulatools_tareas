meta {
  name: /tasks/{id} (PUT)
  type: http
  seq: 50
}

put {
  url: {{baseUrl}}/tasks/{{taskId}}
}

body:json {
  {
    "name": "Chapter 1",
    "description": "Read and answer questions 1–5.",
    "due_at": "2026-10-15T23:59:00-06:00"
  }
}

docs {
  PUT `/tasks/id` Roles: Admin, task's teacher. Path ids: id. JSON body: name, description, due_at; use valid IDs and dates accepted by the API. Response: 200/201 data with task or delivery. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 200

}
