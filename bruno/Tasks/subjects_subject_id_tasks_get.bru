docs {
  GET `/subjects/subject_id/tasks` Roles: Admin, assigned teacher, enrolled student. Path ids: subject_id. Response: 200 paginated data and meta (page, per_page, total) paginated list. Errors: validation 400, unauthenticated 401, forbidden 403, missing resource 404, invalid state 422 where applicable.
}

assert {

  res.status: eq 200

