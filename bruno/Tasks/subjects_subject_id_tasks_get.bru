meta {
  name: /subjects/{subject_id}/tasks (GET)
  type: http
  seq: 45
}

get {
  url: {{baseUrl}}/subjects/{{subjectId}}/tasks?cycle_id={{cycleId}}
  auth: inherit
}

docs {
  GET `/subjects/subject_id/tasks` Roles: Admin, assigned teacher, enrolled student. Path ids: subject_id. Response: 200 {items:[...],page,per_page,total,total_pages}. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body.items: isArray
  res.body.page: isDefined
  res.body.per_page: isDefined
  res.body.total: isDefined
  res.body.total_pages: isDefined

}
