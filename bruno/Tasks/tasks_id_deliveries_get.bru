get {
  url: {{baseUrl}}/tasks/{{taskId}}/deliveries
}

docs {
  GET `/tasks/id/deliveries` Roles: Admin, task's teacher, enrolled student. Path ids: id. Response: 200 bare JSON array; pagination in X-Total-Count, X-Page, X-Per-Page headers. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isArray
  res.headers["X-Total-Count"][0]: isDefined
