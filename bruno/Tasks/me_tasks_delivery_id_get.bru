docs {
  GET `/me/tasks/delivery_id` Roles: Student (own delivery). Path ids: delivery_id. Response: 200 bare object containing task, subject, teacher, and delivery. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isObject

