meta {
  name: /school (GET)
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/school
  auth: inherit
}

docs {
  GET `/school` Roles: Any authenticated role. Parameters: none. Response: 200 bare school object with id, name, address, phone, email, and `logo_url` (null or `/uploads/school/<file>`). Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
