meta {
  name: /school (PUT)
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/school
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Northstar Academy"
  }
}

docs {
  PUT `/school` Roles: Admin. JSON body: name; use valid IDs and dates accepted by the API. Response: 200 bare school object with id and name. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
