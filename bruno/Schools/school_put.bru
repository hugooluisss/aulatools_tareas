meta {
  name: /school (PUT)
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/school
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Northstar Academy",
    "address": "100 School Road",
    "phone": "+52 55 1234 5678",
    "email": "contact@northstar.example"
  }
}

docs {
  PUT `/school` Roles: Admin. JSON body: name, address, phone, email. Response: 200 bare school object with id, name, address, phone, email, and `logo_url` (null or `/uploads/school/<file>`); PUT does not modify the logo. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isJson

}
