meta {
  name: /calendar/events/{id} (GET)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/calendar/events/{{eventId}}
}

docs {
  GET `/calendar/events/id` Roles: Admin. Path ids: id. Response: 200 bare event object with event id, school_id, subject_id, title, description, starts_at, ends_at. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isObject

}
