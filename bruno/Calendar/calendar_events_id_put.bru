meta {
  name: /calendar/events/{id} (PUT)
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/calendar/events/{{eventId}}
}

body:json {
  {
    "subject_id": "{{subjectId}}",
    "title": "Science lab",
    "description": "Bring lab notebook.",
    "starts_at": "2026-10-15T10:00:00-06:00",
    "ends_at": "2026-10-15T11:30:00-06:00"
  }
}

docs {
  PUT `/calendar/events/id` Roles: Admin. Path ids: id. JSON body: subject_id, title, description, starts_at, ends_at; use valid IDs and dates accepted by the API. Response: 200 bare event object with event id, school_id, subject_id, title, description, starts_at, ends_at. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isObject

}
