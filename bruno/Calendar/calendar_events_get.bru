meta {
  name: /calendar/events (GET)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/calendar/events
  auth: inherit
}

docs {
  GET `/calendar/events` Roles: Admin. Parameters: none. Response: 200 bare JSON array; pagination in X-Total-Count, X-Page, X-Per-Page headers. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isArray
  res.headers["X-Total-Count"][0]: isDefined
  res.headers["X-Page"][0]: isDefined
  res.headers["X-Per-Page"][0]: isDefined

}
