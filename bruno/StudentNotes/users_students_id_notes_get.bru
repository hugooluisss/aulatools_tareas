meta {
  name: /users/students/{id}/notes (GET)
  type: http
  seq: 41
}

get {
  url: {{baseUrl}}/users/students/{{studentId}}/notes?page=1&per_page=20
  auth: inherit
}

docs {
  GET `/users/students/id/notes?page&per_page` Roles: same-school admin and teachers assigned through the student's subject binding or subject. Returns {items:[note objects],page,per_page,total,total_pages}. Students receive 404; unrelated teachers receive 403.
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.page: isDefined
  res.body.per_page: isDefined
  res.body.total: isDefined
  res.body.total_pages: isDefined
}
