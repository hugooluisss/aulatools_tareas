meta {
  name: /users/students/{id}/notes (POST)
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/users/students/{{studentId}}/notes
  body: json
  auth: inherit
}

body:json {
  {
    "body": "Follow up with the student about the submitted work."
  }
}

docs {
  POST `/users/students/id/notes` Roles: same-school admin and teachers assigned through the student's subject binding or subject. JSON body: `{body}` (1–2000 trimmed characters). Returns 201 with `{id,student_id,author:{id,first_name,last_name,role},body,created_at}`. Students receive 404; unrelated teachers receive 403.
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.student_id: isDefined
  res.body.author: isJson
  res.body.body: isDefined
  res.body.created_at: isDefined
}
