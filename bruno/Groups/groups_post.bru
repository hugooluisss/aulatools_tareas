meta {
  name: /groups (POST)
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{groupName}}",
    "cycle_id": "{{cycleId}}",
    "subject_ids": {{subjectIds}},
    "teacher_id": {{teacherId}}
  }
}

docs {
  POST `/groups` Roles: Admin. JSON body: name, cycle_id, subject_ids, optional teacher_id (null for none). The cycle, every active subject, and teacher must belong to the user's school. Response: 201 bare resource object including teacher_id; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isJson

}
