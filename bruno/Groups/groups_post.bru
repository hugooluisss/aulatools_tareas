meta {
  name: /groups (POST)
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/groups
}

body:json {
  {
    "name": "Grade 7 A",
    "subject_ids": [
      "{{subjectId}}"
    ]
  }
}

docs {
  POST `/groups` Roles: Admin. JSON body: name, subject_ids; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 201
  res.body: isObject

}
