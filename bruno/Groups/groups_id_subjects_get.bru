  auth: inherit
}

docs {
  GET `/groups/id/subjects` Roles: Admin. Path ids: id. Response: 200 {items:[...],page,per_page,total,total_pages}. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

