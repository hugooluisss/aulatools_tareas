meta {
  name: /groups (GET)
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/groups
  auth: inherit
}

docs {
  GET `/groups` Roles: Admin. Response: 200 bare JSON array including teacher_id; pagination in X-Total-Count, X-Page, X-Per-Page headers. Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isArray
  res.headers["X-Total-Count"][0]: isDefined
  res.headers["X-Page"][0]: isDefined
  res.headers["X-Per-Page"][0]: isDefined

}
