    "subject_ids": [
      "{{subjectId}}"
    ]
  }
}

docs {
  PUT `/groups/id` Roles: Admin. Path ids: id. JSON body: name, subject_ids; use valid IDs and dates accepted by the API. Response: 200 bare resource object; Errors: {error:{code,message}} with HTTP 400/401/403/404/409/422/500 as applicable.
}

assert {

  res.status: eq 200
  res.body: isObject

