{
  "name": "aulatools/tareas-api",
  "type": "project",
  "require": {
    "php": "^8.3",
    "yiisoft/yii-runner-http": "^3.2",
    "yiisoft/log": "^2.2",
    "yiisoft/yii-runner-console": "^2.2",
    "yiisoft/router": "^3.1",
    "yiisoft/di": "^1.4",
    "yiisoft/db": "^2.0",
    "yiisoft/db-mysql": "^2.0",
    "yiisoft/db-migration": "^2.1",
    "vlucas/phpdotenv": "^5.6",
    "yiisoft/injector": "^1.2",
    "yiisoft/cache": "^3.0",
    "psr/simple-cache-implementation": "^3.0",
    "yiisoft/validator": "^2.6",
    "yiisoft/yii-http": "^1.1",
    "psr/http-factory-implementation": "1.0",
    "httpsoft/http-message": "^1.1.6",
    "yiisoft/router-fastroute": "^3.0",
    "firebase/php-jwt": "^6.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "yii-db-migration",
    "format": "php-cs-fixer fix --using-cache=no",
    "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no && php check-line-length.php"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii-runner-composer": true,
      "yiisoft/config": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "config-plugin-file": "config/configuration.php"
  }
}
